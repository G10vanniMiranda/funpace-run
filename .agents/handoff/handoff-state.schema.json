{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funpace.club/schemas/agent-handoff-state.json",
  "title": "FUNPACE Agent Handoff State",
  "description": "Optional machine-readable execution checkpoint. Mirrors .agents/handoff/HANDOFF.template.md. A runtime instance lives at .tmp/handoff/handoff-state.json and is never committed. Never contains secrets or raw PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission",
    "objective",
    "phase",
    "status",
    "checkpoint",
    "sourceOfTruth",
    "branch",
    "head",
    "baseSha",
    "productionSha",
    "worktree",
    "dirtyTree",
    "protectedPaths",
    "mutationLedger",
    "authorizationState",
    "blockers",
    "unknown",
    "humanGates",
    "rollback",
    "nextSafeAction",
    "doNotRepeat"
  ],
  "properties": {
    "mission": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "phase": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "BLOCKED",
        "HUMAN_GATE",
        "READY_TO_CONTINUE",
        "READY_TO_RELEASE",
        "RELEASED",
        "VERIFIED",
        "ABORTED"
      ]
    },
    "checkpoint": { "type": "string" },
    "sourceOfTruth": { "type": "string" },
    "branch": { "type": "string" },
    "head": { "type": "string" },
    "baseSha": { "type": "string" },
    "productionSha": { "type": "string" },
    "worktree": { "type": "string" },
    "dirtyTree": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "classification"],
        "properties": {
          "path": { "type": "string" },
          "status": { "type": "string" },
          "classification": {
            "type": "string",
            "enum": ["task", "preexisting", "generated", "unknown"]
          }
        }
      }
    },
    "protectedPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status", "classification"],
        "properties": {
          "path": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["MODIFIED", "UNTRACKED", "STAGED", "CLEAN"]
          },
          "classification": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "mutationLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "GIT",
        "GITHUB",
        "DATABASE",
        "PAYMENT",
        "EMAIL",
        "SHEETS",
        "META",
        "VERCEL",
        "SUPABASE",
        "FILESYSTEM",
        "OTHER"
      ],
      "patternProperties": {
        "^(GIT|GITHUB|DATABASE|PAYMENT|EMAIL|SHEETS|META|VERCEL|SUPABASE|FILESYSTEM|OTHER)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {
              "type": "string",
              "enum": ["NONE", "READ_ONLY", "MUTATED", "UNKNOWN"]
            },
            "detail": { "type": "string" },
            "reversible": { "type": "boolean" }
          }
        }
      }
    },
    "authorizationState": {
      "type": "string",
      "enum": [
        "AUTHORIZED",
        "NOT_AUTHORIZED",
        "REQUIRES_HUMAN_GATE",
        "EXPIRED_AUTHORIZATION",
        "UNKNOWN"
      ]
    },
    "tests": { "type": "string" },
    "ci": { "type": "string" },
    "deployment": { "type": "string" },
    "blockers": { "type": "string" },
    "unknown": { "type": "string" },
    "humanGates": { "type": "string" },
    "rollback": { "type": "string" },
    "nextSafeAction": { "type": "string", "minLength": 1 },
    "doNotRepeat": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "references": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
