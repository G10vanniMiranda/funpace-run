{
  "functions": {
    "api/cron/google-sheets.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/payments",
      "schedule": "17 7 * * *"
    },
    {
      "path": "/api/cron/meta",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/google-sheets",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
