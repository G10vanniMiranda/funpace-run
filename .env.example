# Public app URL used by links, redirects, SEO and future checkout callbacks.
APP_URL=https://www.funpace.club
NEXT_PUBLIC_SITE_URL=https://www.funpace.club

# API origin used by the registration form.
VITE_API_URL=https://www.funpace.club
VITE_API_URL_LOCAL=http://localhost:3001
VITE_WHATSAPP_NUMBER=SEUNUMERO
API_PORT=3001
API_PUBLIC_URL=https://www.funpace.club
ALLOWED_ORIGINS=https://funpace.club,https://www.funpace.club,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# InfinitePay checkout integration.
PAYMENT_PROVIDER=infinitepay
INFINITEPAY_HANDLE=lucas-romulo
PAYMENT_WEBHOOK_SECRET=""
PENDING_PAYMENT_TTL_MINUTES=30
PARTNERSHIP_WEBHOOK_URL=""

# Transactional e-mail. Use EMAIL_PROVIDER=console locally to log e-mails without sending.
EMAIL_PROVIDER=resend
RESEND_API_KEY=""
EMAIL_FROM="FunPace Run <inscricoes@funpace.club>"
EMAIL_REPLY_TO="funpacerunclub@gmail.com"

# Supabase/Postgres database. Keep DATABASE_URL empty locally to use DATABASE_FILE.
DATABASE_PROVIDER=
DATABASE_URL=
DATABASE_SSL=true
DATABASE_FILE=data/funpace-db.json
BACKUP_DIR=backups
ADMIN_SESSION_SECRET=""
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_USERNAME="Administrador"
# Opcional: substitui ADMIN_USERNAME/ADMIN_API_KEY por usuarios individuais.
# ADMIN_USERS_JSON='[{"username":"Admin","key":"troque-esta-chave","role":"administrator"},{"username":"Financeiro","key":"troque-esta-chave","role":"finance"},{"username":"Operacao","key":"troque-esta-chave","role":"operation"}]'
# ADMIN_API_KEY fica restrita ao login administrativo e nao mais autentica requests.
ADMIN_API_KEY=change-me
