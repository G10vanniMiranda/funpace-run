# Public app URL used by links, redirects, SEO and future checkout callbacks.
APP_ENV=development
APP_URL=https://www.funpace.club
NEXT_PUBLIC_SITE_URL=https://www.funpace.club

# API origin used by the registration form.
VITE_API_URL=https://www.funpace.club
VITE_API_URL_LOCAL=http://localhost:3001
VITE_PUBLIC_SITE_URL=https://funpace.club
VITE_REGISTRATION_TIMEOUT_MS=120000
VITE_WHATSAPP_NUMBER=SEUNUMERO
# Meta Pixel (public browser identifier; it is not a secret).
VITE_META_PIXEL_ID=1033672682712625
# Set to true when a marketing-consent UI is connected to setMetaPixelConsent().
VITE_META_PIXEL_REQUIRE_CONSENT=false
API_PORT=3001
API_PUBLIC_URL=https://www.funpace.club
ALLOWED_ORIGINS=https://funpace.club,https://www.funpace.club,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# InfinitePay checkout integration.
PAYMENTS_ENABLED=false
HOMOLOGATION_PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=
INFINITEPAY_HANDLE=
PAYMENT_WEBHOOK_SECRET=""
# Shared secret used by Vercel Cron for automatic payment/e-mail recovery.
CRON_ENABLED=false
HOMOLOGATION_CRON_ENABLED=false
CRON_SECRET=""
META_BROWSER_PURCHASE_MAX_AGE_MINUTES="1440"
PAYMENT_FEE_PERCENT="0"
PAYMENT_FEE_FIXED_CENTS="0"
PENDING_PAYMENT_TTL_MINUTES=30
OUTBOUND_WEBHOOKS_ENABLED=false
HOMOLOGATION_OUTBOUND_WEBHOOKS_ENABLED=false
PARTNERSHIP_WEBHOOK_URL=""

# Meta Conversions API (server-only; never prefix tokens with VITE_).
META_CAPI_ENABLED=false
META_PIXEL_ID=1033672682712625
META_CONVERSIONS_API_TOKEN=""
META_GRAPH_API_VERSION=
META_DATASET_QUALITY_TOKEN=""
META_TEST_EVENT_CODE=""
META_CAPI_TIMEOUT_MS=3500
META_CAPI_MAX_ATTEMPTS=5

# Transactional e-mail. Use EMAIL_PROVIDER=console locally to log e-mails without sending.
EMAIL_ENABLED=false
HOMOLOGATION_EMAIL_ALLOWLIST=
EMAIL_PROVIDER=
RESEND_API_KEY=""
EMAIL_FROM="FunPace Run <inscricoes@funpace.club>"
EMAIL_REPLY_TO="funpacerunclub@gmail.com"

# Supabase/Postgres database. Keep DATABASE_URL empty locally to use DATABASE_FILE.
DATABASE_PROVIDER=
DATABASE_URL=
EXPECTED_DATABASE_PROJECT_REF=
DATABASE_SSL=true
# Keep this at 1 for serverless deployments. Prefer the Supabase transaction
# pooler URL (port 6543) in DATABASE_URL.
DATABASE_POOL_MAX=1
DATABASE_FILE=data/funpace-db.json
BACKUP_DIR=backups
ADMIN_SESSION_SECRET=""
# Optional dedicated signing secret for partner links; falls back to ADMIN_SESSION_SECRET.
PARTNER_SESSION_SECRET=""
# Short-lived partner benefit handoff (clamped by the API to 5-60 minutes).
PARTNER_SESSION_TTL_SECONDS=1800
ADMIN_SESSION_TTL_SECONDS=28800
# Bootstrap opcional: na primeira subida da API, cria/atualiza um admin no banco.
# Depois de confirmar o acesso, remova estas variaveis do ambiente.
ADMIN_EMAIL="admin@funpace.club"
ADMIN_PASSWORD="troque-esta-senha"
# Compatibilidade legada: ADMIN_USERNAME/ADMIN_API_KEY ainda podem ser usados apenas como fallback de segredo de sessao.
ADMIN_API_KEY=change-me

# Google Sheets operational copy. Credentials are backend-only; never use a VITE_ prefix.
GOOGLE_SHEETS_ENABLED=false
HOMOLOGATION_GOOGLE_SHEETS_ENABLED=false
# Keep false during the three-row canary. Enable only after canary validation.
GOOGLE_SHEETS_REMARKETING_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Store as a single line with escaped newlines (\\n), especially on Vercel.
GOOGLE_PRIVATE_KEY=""
